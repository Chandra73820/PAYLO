      "WindowSeconds": 60
    },
    "ApiKey": {
      "PermitLimit": 1000,
      "WindowSeconds": 60
    },
    "Sensitive": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "WhitelistedIps": [ "127.0.0.1", "::1" ]
  },

  "HealthChecks": {
    "DatabaseTimeoutMs": 3000,
    "DatabaseDegradedMs": 1000,
    "MemoryThresholdMb": 1024
