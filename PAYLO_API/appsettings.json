  "Cors": {
    "Policies": {
      "Default": {
        "AllowedOrigins": [ "https://localhost:7088" ],
        "AllowedMethods": [ "GET", "POST", "PUT", "DELETE", "PATCH" ],
        "AllowedHeaders": [ "Content-Type", "Authorization", "X-API-Key", "X-Correlation-Id", "X-GlobalUser-Id" ],
        "ExposedHeaders": [ "X-Correlation-Id", "Token-Expired" ],
        "AllowCredentials": true,
        "MaxAgeSeconds": 600
      },
      "Public": {
        "AllowedOrigins": [ "*" ],
        "AllowedMethods": [ "GET", "OPTIONS" ],
        "AllowedHeaders": [ "Content-Type" ],
        "ExposedHeaders": [],
        "AllowCredentials": false,
        "MaxAgeSeconds": 86400
      }
